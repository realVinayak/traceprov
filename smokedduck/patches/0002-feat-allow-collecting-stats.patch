---
 src/execution/lineage/lineage_query.cpp       | 575 ++++++++++++++++++
 src/execution/lineage/operator_lineage.cpp    |  40 +-
 src/function/table/system/lineage_query.cpp   | 136 +++++
 src/function/table/system_functions.cpp       |   1 +
