+
+struct LineageQueryStatsBindData : public TableFunctionData {
+  idx_t qid;
+  int opid;
+  shared_ptr<OperatorLineage> lop;
+  unordered_map<idx_t, vector<vector<idx_t>>> out_per_source;
+  unordered_map<idx_t, vector<vector<idx_t>>>::iterator source_iter;
+  OperatorLQStatsMapping::iterator stats_iter;
+  OperatorLQStatsMapping::iterator log_stats_iter;
+  OperatorLQStatsMapping stats_mapping;
+  OperatorLQStatsMapping log_stats_mapping;
+  idx_t oid;
+  int log_stats;
+
+  void Initialize() {
+    qid = -1;
+    opid = -1;
+    log_stats = 0;
+  }
+};
+
+static unique_ptr<FunctionData> LineageQueryBindStats(
+  ClientContext &context,
+  TableFunctionBindInput &input,
+  vector<LogicalType> &return_types,
+  vector<string> &names
+) {
+    auto result = make_uniq<LineageQueryStatsBindData>();
+    if (input.inputs.size() != 3) {
+      throw BinderException("lineage_query_stats(qid:int, opid:int, oid:[uint], log_stats: int)");
+    }
+
+    bool debug = false;
+    result->qid = input.inputs[0].GetValue<int>();
+    result->opid = input.inputs[1].GetValue<int>();
+    result->oid = input.inputs[2].GetValue<int>();
+    // result->log_stats = input.inputs[3].GetValue<int>();
+
+    // read and initalize idx_t qid; idx_t opid;
+    auto lop = lineage_manager->queryid_to_plan[result->qid];
+    if (result->opid < 100)
+      result->lop = GetLop(lop, result->opid);
+    else
+      result->lop = GetNextChild(lop);
+    if (result->lop == nullptr) return std::move(result);
+    if (debug) std::cout << "LQ: "<< result->opid << " " << result->qid << std::endl;
+    
+
+    clock_t start = clock();
+    vector<idx_t> log_context = result->lop->ResolveGlobal(result->oid);
+    clock_t end = clock();
+    float resolve_time = ((float) end - start) / CLOCKS_PER_SEC;
+
+    unordered_map<idx_t, vector<idx_t>> oids_per_lsn, oids_per_lsn_2;
+    if (!log_context.empty())  {
+      // std::cout << " log context: " << log_context[0] << " " << log_context[1] << std::endl;
+      oids_per_lsn[log_context[0]] = {log_context[1]};
+      oids_per_lsn_2[log_context[0]] = {log_context[1]};
+    }
+    start = clock();
+    unordered_map<idx_t, vector<vector<idx_t>>> out_per_source_1, out_per_source_2;
+    result->lop->LQStats(oids_per_lsn, out_per_source_1, &result->stats_mapping, false);
+    result->lop->LQStats(oids_per_lsn_2, out_per_source_2, &result->log_stats_mapping, true);
+    end = clock();
+    float lq_time = ((float) end - start) / CLOCKS_PER_SEC;
+    result->out_per_source = out_per_source_1;
+    //std::cout << "out_per_source: " << result->out_per_source.size() <<
+    // " resolve " << resolve_time << " lq: " << lq_time << std::endl;
+    if (result->out_per_source.empty()){
+        throw BinderException("Try different value!");
+    }
+
+    if (debug) std::cout << "|source| = " << result->out_per_source.size() << std::endl;
+
+    return_types.emplace_back(LogicalType::BIGINT);
+    names.emplace_back("opid");
+    return_types.emplace_back(LogicalType::BIGINT);
+    names.emplace_back("log");
+    return_types.emplace_back(LogicalType::VARCHAR);
+    names.emplace_back("stats");
+    // return_types.emplace_back(LogicalType::ROW_TYPE);
+    // names.emplace_back("iid");
+    
+    result->source_iter = result->out_per_source.begin();
+    result->stats_iter = result->stats_mapping.begin();
+    result->log_stats_iter = result->log_stats_mapping.begin();
+
+    return std::move(result);
+  }
+
+std::string stats_to_str(OperatorLQStats stats){
+    std::string stat_str = "{";
+    stat_str += "\"total_time\": " + std::to_string(stats.time.total_time);
+    stat_str += ",";
+    stat_str += "\"perfect_join_time\": " + std::to_string(stats.time.perfect_join_time);
+    stat_str += ",";
+    stat_str += "\"right_join_time\": " + std::to_string(stats.time.right_join_time);
+    stat_str += ",";
+    stat_str += "\"log_size_time\": " + std::to_string(stats.time.log_size_time);
+    stat_str += ",";
+    stat_str += "\"left_join_time\": " + std::to_string(stats.time.left_join_time);
+    stat_str += ",";
+    stat_str += "\"left_probe_time\": " + std::to_string(stats.time.left_probe_time);
+    stat_str += ",";
+    stat_str += "\"misc_setup\": " + std::to_string(stats.time.misc_setup);
+    stat_str += ",";
+    stat_str += "\"call_stats\": " + log_stats_to_str(stats.log_stats);
+    stat_str += "}";
+    return stat_str;
+}
+
+void LineageQueryStatsFunction(ClientContext &context, TableFunctionInput &data_p, DataChunk &output) {
+    auto &ldata = data_p.local_state->Cast<LineageQueryLocalState>();
+    auto &gdata = data_p.global_state->Cast<LineageQueryGlobalState>();
+    auto &bdata = data_p.bind_data->CastNoConst<LineageQueryStatsBindData>();
+    if (bdata.stats_iter == bdata.stats_mapping.end() && bdata.log_stats_iter == bdata.log_stats_mapping.end()) return;
+
+    const bool is_log = bdata.stats_iter == bdata.stats_mapping.end();
+    // Eh, can technically vectorize this. But that can be a bit complicated so doing it like this.
+    auto current_iter = (is_log ? &bdata.log_stats_iter : &bdata.stats_iter);
+    auto const op_id = (*current_iter)->first;
+    auto const stats = (*current_iter)->second;
+    output.SetValue(0, 0, Value::BIGINT(op_id));
+    output.SetValue(1, 0, Value::BIGINT((int64_t)is_log));
+    output.SetValue(2, 0, stats_to_str(stats));
+    output.SetCardinality(1);
+    (*current_iter)++;
+}
+
+void LineageQueryStatsFun::RegisterFunction(BuiltinFunctions &set) {
+	set.AddFunction(TableFunction("lineage_query_stats",
+        {duckdb::LogicalType::INTEGER, duckdb::LogicalType::INTEGER,
+        LogicalType::UINTEGER},
+        LineageQueryStatsFunction, LineageQueryBindStats, LineageQueryGlobalInit, LineageQueryLocalInit));
+}
+
 } // namespace duckdb
 #endif
