             get_perfect_right_match(in_right, scatter_keys);
             get_right_match(scatter_keys, right_oids_per_lsn);
           }
-          if (left) {
+          if (left == (sel_t*)(-1)){
+            // std::cout << "Handling negative" << std::endl;
