               idx_t oid = oids[o];
               oids[o] = left[oid];
@@ -1168,12 +1177,16 @@ void OperatorLineage::LQStats(
       child->LQStats( oids_per_lsn, sources, stats_mapping, compute_log_stats );
       break;
     } case PhysicalOperatorType::HASH_JOIN: {
+      const auto _main_start = std::chrono::steady_clock::now();
       unordered_map<idx_t, vector<idx_t>> oids_per_lsn;
       auto child = GetNextChild(children[0]);
       idx_t child_max_threads = child->thread_vec.size();
       unordered_map<idx_t, vector<idx_t>> right_oids_per_lsn;
       unordered_map<void*, idx_t> thread_vec_map_local = get_threads_map(child->thread_vec);
+      const auto _main_end = std::chrono::steady_clock::now();
+      time_stats.misc_setup += GET_DURATION(_main_start, _main_end);
       for (auto& e : log_context) {
+        const auto _loop_start = std::chrono::steady_clock::now();
         pair<idx_t, idx_t> tid_lsn = decode_pk(e.first, max_threads);
         vector<idx_t>& oids = e.second;
         idx_t lsn = tid_lsn.second;
@@ -1182,15 +1195,23 @@ void OperatorLineage::LQStats(
         if (debug) std::cout << "JOIN 1: tid(" <<  tid_lsn.first << "), lsn(" << tid_lsn.second << ")," << " |oids|: " << oids.size() << std::endl;
         
         auto tid_it = thread_vec_map_local.find(thread_val);
-        if (tid_it == thread_vec_map_local.end()) continue;
+        if (tid_it == thread_vec_map_local.end()){
+          const auto _loop_end = std::chrono::steady_clock::now();
+          time_stats.misc_setup += GET_DURATION(_loop_start, _loop_end);
+          continue;
+        }
         idx_t child_tid = tid_it->second;
 
         D_ASSERT(lsn < tlog->execute_internal.size());
         int blsn = tlog->execute_internal[lsn].first-1;
         int in_lsn = tlog->execute_internal[lsn].second-1;
         if (debug) std::cout << "JOIN 2: blsn(" <<  blsn << "), lsn(" << in_lsn << ")," << " child_tid: " << child_tid << std::endl;
+        const auto _loop_end = std::chrono::steady_clock::now();
+        time_stats.misc_setup += GET_DURATION(_loop_start, _loop_end);
+        // Unlikely that the below instructon takes forever.
         if (blsn < 0) continue;
         if (!tlog->perfect_probe_ht_log.empty()) {
+          const auto _misc_start = std::chrono::steady_clock::now();
           idx_t count = tlog->perfect_probe_ht_log[blsn].count;
           auto left = tlog->perfect_probe_ht_log[blsn].left;
           auto right = tlog->perfect_probe_ht_log[blsn].right;
@@ -1201,6 +1222,8 @@ void OperatorLineage::LQStats(
             // So, need to append.
             oids_per_lsn[in_pk].insert(oids_per_lsn[in_pk].end(), oids.begin(), oids.end());
           }
+          const auto _misc_end = std::chrono::steady_clock::now();
+          time_stats.misc_setup += GET_DURATION(_misc_start, _misc_end);
           if (right) {
             const auto start_perfect = std::chrono::steady_clock::now();
             for (idx_t o=0; o < oids.size(); ++o) {
@@ -1214,10 +1237,22 @@ void OperatorLineage::LQStats(
