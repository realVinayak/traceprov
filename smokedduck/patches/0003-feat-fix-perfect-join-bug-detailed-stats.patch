             const auto end_right = std::chrono::steady_clock::now();
             time_stats.right_join_time += (GET_DURATION(end_perfect, end_right));
-            time_stats.perfect_join_time += (GET_DURATION(start_perfect, end_right));
+            time_stats.perfect_join_time += (GET_DURATION(start_perfect, end_perfect));
           }
-
-          if (left) {
+          if (left == (sel_t*)(-1)){
+            const auto start_left = std::chrono::steady_clock::now();
+            // this means that all the entries in this chunk had a matching one.
+            vector<idx_t> new_oids(STANDARD_VECTOR_SIZE);
+            for (idx_t o=0; o < new_oids.size(); ++o){
+              new_oids[o] = o;
+            }
+            const auto end_left_probe = std::chrono::steady_clock::now();
+            idx_t in_pk = encode(in_lsn, child_tid, child_max_threads);
+            oids_per_lsn[in_pk].insert(oids_per_lsn[in_pk].end(), new_oids.begin(), new_oids.end());
+            const auto end_left_insert = std::chrono::steady_clock::now();
+            time_stats.left_join_time += GET_DURATION(end_left_probe, end_left_insert);
+            time_stats.left_probe_time += GET_DURATION(start_left, end_left_probe);
+          } else if (left) {
             const auto start_left = std::chrono::steady_clock::now();
             for (idx_t o=0; o < oids.size(); ++o) {
               idx_t oid = oids[o];
@@ -1231,10 +1266,13 @@ void OperatorLineage::LQStats(
             time_stats.left_probe_time += GET_DURATION(start_left, end_left_probe);
           }
         } else if (!tlog->join_gather_log.empty()) {
+          const auto _misc_start = std::chrono::steady_clock::now();
           idx_t count = tlog->join_gather_log[blsn].count;
           auto payload = tlog->join_gather_log[blsn].rhs;
           auto lhs = tlog->join_gather_log[blsn].lhs;
           vector<data_ptr_t> in_right(oids.size());
+          const auto _misc_end = std::chrono::steady_clock::now();
+          time_stats.misc_setup += GET_DURATION(_misc_start, _misc_end);
           if (!payload && !lhs) { // mark join
             idx_t in_pk = encode(in_lsn, child_tid, child_max_threads);
             oids_per_lsn[in_pk].insert(oids_per_lsn[in_pk].end(), oids.begin(), oids.end());
@@ -1398,6 +1436,7 @@ void OperatorLineage::LQStats(
     stats_mapping->insert({operator_id, lq_stats});
   }else{
     stats_mapping->at(operator_id).time.total_time = time_stats.total_time;
+    stats_mapping->at(operator_id).time.misc_setup += time_stats.misc_setup;
   }
 
 }
